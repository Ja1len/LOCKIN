# Neon Postgres — from your Neon project's connection string (pooled, with sslmode=require)
DATABASE_URL=

# Session signing secret — generate with: openssl rand -base64 32
JWT_SECRET=

# Cloudinary — from your Cloudinary dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# NVIDIA NIM — from build.nvidia.com (free tier API key)
NVIDIA_NIM_API_KEY=

# Pusher — from your Pusher Channels app dashboard
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=
